import {
  convertToModelMessages,
  isStepCount,
  streamText,
  tool,
  type UIMessage,
} from 'ai';
import { z } from 'zod';
import { NIMBUS_BOTS } from '@/packages/vertical-blueprints/bots';
import type { NimbusBrowserPolicy } from '@/packages/vertical-blueprints/schema';

export const maxDuration = 60;

function isDomainAllowed(rawUrl: string, policy: NimbusBrowserPolicy): boolean {
  if (policy.allowedDomains.includes('*')) return true;
  const { hostname, host } = new URL(rawUrl);
  return policy.allowedDomains.some((pattern) => {
    if (pattern.startsWith('*.')) {
      const suffix = pattern.slice(1);
      return hostname.endsWith(suffix) || hostname === pattern.slice(2);
    }
    return hostname === pattern || host === pattern;
  });
}

