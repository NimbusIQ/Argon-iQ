  enabled: boolean;
  allowedDomains: string[]; // e.g. ["*.salesforce.com", "localhost:3000", "*"]
  blockedActions: ('purchase' | 'delete' | 'file_upload')[];
  requireApprovalOnSubmit: boolean;
  persistSessionVault: boolean;
}

