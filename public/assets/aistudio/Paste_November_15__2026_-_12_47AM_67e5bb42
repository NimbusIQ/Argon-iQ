export async function POST(req: Request) {
  const {
    messages,
    botId = 'sovereign-builder',
    tenantId,
    sessionId = crypto.randomUUID(),
  } = (await req.json()) as {
    messages: UIMessage[];
    botId?: string;
    tenantId: string;
    sessionId?: string;
  };

  if (!tenantId) {
    return Response.json({ error: 'tenantId is required for sovereign isolation' }, { status: 400 });
  }

  const bot = NIMBUS_BOTS.find((b) => b.id === botId) ?? NIMBUS_BOTS[0];
  const activeTools: Record<string, any> = {};

  // 1. Ephemeral Code Sandbox Plane
  if (bot.capabilities.codeSandbox) {
    activeTools.runSandboxCode = tool({
      description: 'Execute Python, TypeScript, or bash inside an isolated tenant sandbox.',
      inputSchema: z.object({
        language: z.enum(['python', 'bash', 'typescript']),
        code: z.string(),
      }),
      execute: async ({ language, code }) => {
        if (bot.sovereignPolicy.auditLedger) {
          await recordAuditEvent({ tenantId, botId: bot.id, sessionId, action: 'runSandboxCode', payload: { language } });
        }
        // Connect to E2B / Modal / Firecracker micro-VM scoped to tenantId
        return {
          status: 'success',
          stdout: `[${tenantId}] Executed ${language} snippet (${code.length} chars).`,
        };
      },
    });
  }

  // 2. Real-Time Web Search Grounding
  if (bot.capabilities.realTimeSearch && bot.sovereignPolicy.allowExternalWebSearch) {
    activeTools.liveWebSearch = tool({
      description: 'Search the live web for real-time facts, API docs, and filings.',
      inputSchema: z.object({ query: z.string() }),
      execute: async ({ query }) => {
        // Connect to Perplexity Sonar / Tavily
        return { results: [`Live verified intelligence for: ${query}`] };
      },
    });
  }

  // 3. Headless Browser Plane (@web-operator & @iq-computer)
  if (bot.capabilities.browserAgent.enabled) {
    const browserPolicy = bot.capabilities.browserAgent;

    activeTools.browser_navigate = tool({
      description: 'Navigate the tenant-isolated cloud browser to a target URL.',
      inputSchema: z.object({ url: z.string().url() }),
      execute: async ({ url }) => {
        if (!isDomainAllowed(url, browserPolicy)) {
          return { status: 'blocked', reason: `Domain not in bot allowlist: ${url}` };
        }
        return {
          status: 'navigated',
          url,
          liveViewerUrl: `https://nimbusiq.ai/sessions/${sessionId}/browser`,
          interactiveElements: '[1] Input: "Search..." | [2] Button: "Sign In"',
        };
      },
    });

    activeTools.browser_act = tool({
      description: 'Interact with a webpage element by its Accessibility ID.',
      inputSchema: z.object({
        action: z.enum(['click', 'type', 'press_enter', 'scroll_down', 'submit_form']),
        elementId: z.number().optional(),
        text: z.string().optional(),
      }),
      // Pause for Human-in-the-Loop approval on form submissions
      needsApproval: ({ action }) =>
        browserPolicy.requireApprovalOnSubmit && action === 'submit_form',
      execute: async ({ action, elementId, text }) => {
        return { status: 'executed', action, elementId, text };
      },
    });

    activeTools.browser_extract = tool({
      description: 'Extract structured JSON data from the active webpage DOM.',
      inputSchema: z.object({
        instruction: z.string(),
        schemaDescription: z.string(),
      }),
      execute: async ({ instruction }) => {
        return { extractedData: { summary: `Structured output for: ${instruction}` } };
      },
    });
  }

  // 4. Virtual Desktop, Terminal & Cross-Domain Interop Plane (@iq-computer)
  if (bot.capabilities.computerAgent.enabled) {
    const computerPolicy = bot.capabilities.computerAgent;

    if (computerPolicy.allowTerminalExec) {
      activeTools.terminal_exec = tool({
        description: 'Run bash, python, or CLI commands in the persistent sovereign workspace.',
        inputSchema: z.object({
          command: z.string(),
          cwd: z.string().default('/workspace'),
          timeoutMs: z.number().default(30000),
        }),
        needsApproval: ({ command }) =>
          computerPolicy.requireApprovalOnShellRisk &&
          /\b(rm\s+-rf|sudo|mkfs|dd|shutdown|curl.*\|.*sh)\b/.test(command),
        execute: async ({ command, cwd }) => {
          const allowed = computerPolicy.allowedRoots.some((root) => cwd.startsWith(root));
          if (!allowed) {
            return { exitCode: 1, stderr: `cwd "${cwd}" outside allowedRoots` };
          }
          return { exitCode: 0, stdout: `[${sessionId}:${cwd}] Executed: ${command}` };
        },
      });
    }

    if (computerPolicy.allowGuiControl) {
      activeTools.computer_gui_action = tool({
        description: 'Control mouse, keyboard, and screen capture on the virtual desktop OS.',
        inputSchema: z.object({
          action: z.enum(['screenshot', 'left_click', 'double_click', 'type_text', 'key_combo', 'scroll']),
          coordinate: z.tuple([z.number(), z.number()]).optional(),
          text: z.string().optional(),
        }),
        execute: async ({ action, coordinate }) => ({
          status: 'ok',
          action,
          coordinate,
          streamUrl: `https://nimbusiq.ai/sessions/${sessionId}/desktop`,
        }),
      });
    }

    activeTools.interop_transfer = tool({
      description: 'Sync files or JSON payloads across terminal filesystem, browser downloads, and MCP connectors.',
      inputSchema: z.object({
        sourceDomain: z.enum(['terminal_fs', 'browser_download', 'mcp_connector']),
        targetDomain: z.enum(['terminal_fs', 's3_sovereign_vault', 'mcp_connector']),
        pathOrResource: z.string(),
      }),
      execute: async ({ sourceDomain, targetDomain, pathOrResource }) => ({
        synced: true,
        route: `${sourceDomain} -> ${targetDomain}`,
        resource: pathOrResource,
      }),
    });
  }

  const governanceBanner = `[SOVEREIGN GOVERNANCE]: Tenant=${tenantId} | Session=${sessionId} | Residency=${bot.sovereignPolicy.dataResidency} | PII_Redaction=${bot.sovereignPolicy.piiRedaction} | AllowedMCP=${bot.allowedMcpTools.join(',')}`;

  const result = streamText({
    model: bot.defaultModel ?? process.env.AI_MODEL ?? 'anthropic/claude-sonnet-5.5',
    system: `${bot.systemPrompt}\n\n${governanceBanner}`,
    messages: await convertToModelMessages(messages),
    tools: activeTools,
    stopWhen: isStepCount(8),
    abortSignal: req.signal,
  });

  return result.toUIMessageStreamResponse();
}
(Note: If you are on AI SDK v6 rather than v7, swap isStepCount(8) for stepCountIs(8); if you are on AI SDK v7 and want the newest approval API, toolApproval supersedes needsApproval[6][7].)
