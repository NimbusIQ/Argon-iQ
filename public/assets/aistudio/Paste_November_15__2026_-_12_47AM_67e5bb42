                          <th className="py-2.5 px-3">Operation</th>
                          <th className="py-2.5 px-3">Verdict</th>
                          <th className="py-2.5 px-3">SHA-256</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800/60 font-mono text-[11px]">
                        {auditEntries.map((row) => (
                          <tr key={row.id} className="hover:bg-slate-900/40">
                            <td className="py-2 px-3 text-slate-400 whitespace-nowrap">{row.timestamp}</td>
                            <td className="py-2 px-3 text-cyan-300 whitespace-nowrap">{row.actor}</td>
                            <td className="py-2 px-3">
                              <span className="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-300">
                                {row.domain}
                              </span>
                            </td>
                            <td className="py-2 px-3 text-slate-200 font-sans text-xs">{row.operation}</td>
                            <td className="py-2 px-3">
                              <span
                                className={`px-1.5 py-0.5 rounded text-[10px] ${
                                  row.verdict === 'HITL_PENDING'
                                    ? 'bg-amber-500/20 text-amber-300'
                                    : 'bg-emerald-500/15 text-emerald-300'
                                }`}
                              >
                                {row.verdict}
                              </span>
                            </td>
                            <td className="py-2 px-3 text-slate-500">{row.sha256}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>
          </section>
        </div>
      )}

      {/* ===================================================================== */}
      {/* MODAL 1: AGENTIC FOUNDRY FACTORY (CREATE CUSTOM CARTRIDGE)            */}
      {/* ===================================================================== */}
      {isFoundryOpen && (
        <div className="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <form
            onSubmit={handleCreateCustomBot}
            className="w-full max-w-lg rounded-2xl bg-[#0B0F19] border border-slate-800 p-6 space-y-4 shadow-2xl"
          >
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <span className="text-[10px] font-mono uppercase text-cyan-400">
                  Nimbus Agentic Foundry Factory
                </span>
                <h3 className="text-base font-semibold text-white">
                  Build Custom Sovereign Bot Cartridge
                </h3>
              </div>
              <button
                type="button"
                onClick={() => setIsFoundryOpen(false)}
                className="text-xs text-slate-400 hover:text-white cursor-pointer"
              >
                ESC
              </button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div>
                <label className="block text-slate-400 mb-1">Bot Handle</label>
                <input
                  value={newBotHandle}
                  onChange={(e) => setNewBotHandle(e.target.value)}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                />
              </div>
              <div>
                <label className="block text-slate-400 mb-1">Enterprise Vertical</label>
                <input
                  value={newBotVertical}
                  onChange={(e) => setNewBotVertical(e.target.value)}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white"
                />
              </div>
            </div>

            <div className="text-xs">
              <label className="block text-slate-400 mb-1">Cartridge Name</label>
              <input
                value={newBotName}
                onChange={(e) => setNewBotName(e.target.value)}
                className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white"
              />
            </div>

            <div className="text-xs">
              <label className="block text-slate-400 mb-1">Sovereign Data Residency Policy</label>
              <select
                value={newBotResidency}
                onChange={(e) => setNewBotResidency(e.target.value as SovereignBot['residency'])}
                className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
              >
                <option value="ON-PREM-VPC">ON-PREM-VPC (mTLS Daemon)</option>
                <option value="US-EAST VPC">US-EAST VPC</option>
                <option value="EU-CENTRAL">EU-CENTRAL (GDPR Strict)</option>
                <option value="SOVEREIGN VM">SOVEREIGN VM (@iq-computer)</option>
                <option value="AIR-GAPPED">AIR-GAPPED</option>
              </select>
            </div>

            <div className="text-xs">
              <label className="block text-slate-400 mb-1">Sovereign RAG Vector Collections (comma-separated)</label>
              <input
                value={newBotRag}
                onChange={(e) => setNewBotRag(e.target.value)}
                className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
              />
            </div>

            <div className="text-xs">
              <label className="block text-slate-400 mb-1">Allowed MCP & Computer Tools (comma-separated)</label>
              <input
                value={newBotMcp}
                onChange={(e) => setNewBotMcp(e.target.value)}
                className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
              />
            </div>

            <div className="flex justify-end gap-2 pt-2">
              <button
                type="button"
                onClick={() => setIsFoundryOpen(false)}
                className="px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300 cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="submit"
                className="px-4 py-2 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-xs cursor-pointer"
              >
                Publish Cartridge to Studio
              </button>
            </div>
          </form>
        </div>
      )}

      {/* ===================================================================== */}
      {/* MODAL 2: SAAS AGENT-AS-A-SERVICE (AaaS) ENDPOINT DEPLOYMENT           */}
      {/* ===================================================================== */}
      {isDeployOpen && (
        <div className="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="w-full max-w-xl rounded-2xl bg-[#0B0F19] border border-slate-800 p-6 space-y-4 shadow-2xl">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <div>
                <span className="text-[10px] font-mono uppercase text-cyan-400">
                  Agent-as-a-Service (AaaS) Control Plane
                </span>
                <h3 className="text-base font-semibold text-white">
                  Production Endpoint · {selectedBot.handle}
                </h3>
              </div>
              <button
                onClick={() => setIsDeployOpen(false)}
                className="text-xs text-slate-400 hover:text-white cursor-pointer"
              >
                ESC
              </button>
            </div>

            <p className="text-xs text-slate-400 leading-relaxed">
              Invoke <span className="text-cyan-300 font-mono">{selectedBot.handle}</span> from any SaaS backend,
              CI/CD pipeline, or peer A2A agent with enforced{' '}
              <span className="text-white font-mono">{selectedBot.residency}</span> isolation:
            </p>

            <div className="relative">
              <pre className="p-4 rounded-xl bg-slate-950 border border-slate-800 text-[11px] font-mono text-cyan-200 overflow-x-auto leading-relaxed">
                {aaasCurlSnippet}
              </pre>
              <button
                onClick={() => {
                  navigator.clipboard?.writeText(aaasCurlSnippet);
                  setCopiedCurl(true);
                  setTimeout(() => setCopiedCurl(false), 1800);
                }}
                className="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[11px] font-mono text-slate-200 flex items-center gap-1 cursor-pointer"
              >
                {copiedCurl ? <Check className="w-3 h-3 text-emerald-400" /> : <Copy className="w-3 h-3" />}
                <span>{copiedCurl ? 'Copied' : 'Copy'}</span>
              </button>
            </div>

            <div className="flex justify-end">
              <button
                onClick={() => setIsDeployOpen(false)}
                className="px-4 py-2 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-xs cursor-pointer"
              >
                Done
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
