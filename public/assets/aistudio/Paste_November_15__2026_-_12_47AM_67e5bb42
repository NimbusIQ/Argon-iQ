        }),
        needsApproval: ({ command }) =>
          computerPolicy.requireApprovalOnShellRisk &&
          /\b(rm\s+-rf|sudo|mkfs|dd|shutdown|curl.*\|.*sh)\b/.test(command),
        execute: async ({ command, cwd }) => {
          const allowed = computerPolicy.allowedRoots.some((root) => cwd.startsWith(root));
          if (!allowed) {
            return { exitCode: 1, stderr: `cwd "${cwd}" outside allowedRoots` };
          }
          return { exitCode: 0, stdout: `[${sessionId}:${cwd}] Executed: ${command}` };
