# ─── OpenAI (existing assistant panel) ───────────────────────────────────────
OPENAI_API_KEY=<your-openai-api-key>

# ─── Google Gemini (NimbusIQ Chat Widget + Coding Agent) ─────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ─── Make.com Webhook (optional — for lead capture forwarding) ────────────────
# Create a webhook scenario in Make.com and paste the URL here
MAKE_WEBHOOK_URL=<your-make-webhook-url>

# ─── Twilio (optional — for SMS lead notifications) ──────────────────────────
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_FROM_NUMBER=<your-twilio-phone-number>
TWILIO_TO_NUMBER=<your-notification-phone-number>
